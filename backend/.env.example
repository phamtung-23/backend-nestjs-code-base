# Used when running the backend directly (yarn start:dev) instead of via
# docker compose. Every variable is validated at startup (src/config/env.validation.ts).

# Application
NODE_ENV=development
PORT=3000

# API — leave API_PREFIX empty when a reverse proxy strips it (Traefik strips /api)
API_PREFIX=
API_VERSION=1

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=change-me-strong-redis-password

# JWT — in production both must be at least 32 characters and different
# (generate with: openssl rand -base64 48)
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here-change-in-production
JWT_EXPIRES_IN=7d

# CORS — exact origins, comma-separated; empty = localhost origins in development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# OTP
OTP_MAX_ATTEMPTS=5

# Swagger UI at /docs (defaults: on outside production, off in production)
SWAGGER_ENABLED=true
SWAGGER_PUBLIC_BASE_URL=http://localhost:3000

# SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@example.com"

# Frontend URL (for email links)
FRONTEND_URL="http://localhost:3000"
