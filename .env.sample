# Environment (development/production)
NODE_ENV=development

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=default
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres?schema=public"

# Redis Configuration
REDIS_HOST=redis
# Used both by the backend to reach Redis inside the compose network (where it
# listens on 6379) and as the dev host port mapping, so keep it at 6379.
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-redis-password

# NestJS Configuration
NESTJS_PORT=3001
NESTJS_CONTAINER_PORT=3001
# With NODE_ENV=production the app refuses to start unless both secrets are at
# least 32 characters and different. Generate with: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-here
JWT_REFRESH_SECRET=your-refresh-jwt-key-here
# Token lifetimes (number + s/m/h/d). Clients refresh the access token with the
# refresh token, so keep the access token short.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Exact origins, comma-separated (no paths, no wildcards), e.g.
# https://app.example.com,https://admin.example.com
# Empty: localhost:3000/5173 in development, CORS disabled in production.
ALLOWED_ORIGINS=

# API Configuration
# Traefik strips `/api` before forwarding, so backend only owns the version segment.
API_PREFIX=
API_VERSION=1

# OTP Configuration
# Emailed 6-digit codes: lifetime (1-60) and wrong guesses allowed per code (1-20)
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Swagger UI at /docs. Leave empty to use the compose defaults: on locally and on
# the dev server, off in prod / prod-ip. Setting it here overrides every file.
SWAGGER_ENABLED=
# Public URLs (will be auto-configured based on DOMAIN)
SWAGGER_PUBLIC_BASE_URL=http://localhost/api

# SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@example.com"

# Frontend URL (for email links)
FRONTEND_URL="http://localhost:3000"

# TRAEFIK CONFIGURATION
# Primary domain (production only, use localhost for development)
DOMAIN=localhost
# Email for Let's Encrypt SSL certificates (production only)
SSL_EMAIL=your-email@domain.com
# Enable SSL redirect (true for production, false for development)
SSL_REDIRECT=false
# Traefik log level (INFO, DEBUG, WARN, ERROR)
TRAEFIK_LOG_LEVEL=INFO
# Enable Traefik dashboard (true for development, false for production)
TRAEFIK_DASHBOARD=true
# Enable Traefik API debugging (true for development, false for production)
TRAEFIK_DEBUG=true
# Basic auth for the Traefik dashboard on the dev SERVER (docker-compose.dev.yml).
# Generate with: htpasswd -nb admin yourpassword
# Then escape every $ as $$ when pasting here.
TRAEFIK_DASHBOARD_USERS=admin:$$apr1$$replace$$with$$real$$hash

